      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchidake Camera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うちだけカメラ"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to turn this iPhone into a monitor camera and send video to other devices in your home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone を見守りカメラにして、家の中の別の端末に映像を送るためにカメラを使用します。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local network is used to connect the camera and the devices you watch from inside your home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家の中にあるカメラと、映像を見る端末をつなぐために、ローカルネットワークを使用します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is used to send the sound around the camera to other devices in your home, and to let you talk while watching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラのまわりの音を家の中の別の端末に送るため、また映像を見ながら話しかけるためにマイクを使用します。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
