                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld devices are watching (sound is on too)"
                }
              }
            }
          }
        }
      }
    },
    "%lld台が視聴中" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld watching"
          }
        }
      }
    },
    "1 台のカメラを、同時に 4 台まで見られます（無料は 1 台）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to 4 devices can watch one camera at once (1 on the free plan)"
          }
        }
      }
    },
    "1 台のカメラを同時に 4 台まで見られ、カメラを 2 台以上使えます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch one camera on up to 4 devices at once, and use two or more cameras."
          }
        }
      }
    },
    "1 台目に表示される QR コードを、2 台目の端末で読み取る" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the QR code shown on the first device with your second device"
          }
        }
      }
    },
    "1 台目の端末" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First device"
          }
        }
      }
    },
    "1 台目の端末で「新しく始める」を押す" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your first device, tap “Start fresh”"
          }
        }
      }
    },
    "2 台目からの端末" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Second device or later"
          }
        }
      }
    },
    "2 台目を追加" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your second device"
          }
        }
      }
    },
    "QR コードを表示" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show QR code"
          }
        }
      }
    },
    "QR コードを読み取る" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan QR code"
          }
        }
      }
    },
    "「QR コードを読み取る」を押す" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap “Scan QR code”"
          }
        }
      }
    },
    "「写真」への追加が許可されていません。設定アプリで許可してください。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding to Photos isn't allowed. Allow it in the Settings app."
          }
        }
      }
    },
    "いまは誰も見ていません" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one is watching right now"
          }
        }
      }
    },
    "この QR コードは家の鍵と同じです。写真に撮ったり、人に送ったりしないでください。写した人は映像を見られます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code is like your house key. Don't photograph it or send it to anyone. Whoever has it can watch your video."
          }
        }
      }
    },
    "この iPhone をカメラにする" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this iPhone as a camera"
          }
        }
      }
    },
    "このアプリの QR コードではありません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This QR code isn't from this app."
          }
        }
      }
    },
    "このカメラは、いま 4 台が見ています。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 devices are already watching this camera."
          }
        }
      }
    },
    "このカメラは、いま別の端末が見ています。カメラの端末を家族プランにすると、同時に 4 台まで見られます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another device is watching this camera right now. With the Family Plan on the camera device, up to 4 devices can watch at once."
          }
        }
      }
    },
    "この家では、すでに「%@」がカメラとして動いています。カメラを 2 台以上使うには、家族プランが必要です。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already running as a camera in this home. To use two or more cameras, you need the Family Plan."
          }
        }
      }
    },
    "この端末ではカメラを使えません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera isn't available on this device."
          }
        }
      }
    },
    "この端末で新しい鍵を作ります。続けて、2 台目に読み取らせる QR コードを表示します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This creates a new key on this device, then shows a QR code for your second device to scan."
          }
        }
      }
    },
    "この端末の鍵を消して、最初の設定からやり直します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This erases the key on this device and starts setup over."
          }
        }
      }
    },
    "この端末は、どちらですか?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which one is this device?"
          }
        }
      }
    },
    "すでに始めている端末で「端末を追加」を押し、表示された QR コードをこの端末で読み取ります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a device that is already set up, tap “Add a device”, then scan the QR code it shows with this device."
          }
        }
      }
    },
    "つながりません。この端末をカメラと同じ QR コードで設定したか、カメラの端末でアプリが開いているかを確かめてください。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't connect. Check that this device was set up with the same QR code as the camera, and that the app is open on the camera."
          }
        }
      }
    },
    "ほかのカメラを確かめています…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking for other cameras…"
          }
        }
      }
    },
    "ほかの端末が録画中" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another device is recording"
          }
        }
      }
    },
    "ほかの端末ですでに始めているときは、ここは押さずに「QR コードを読み取る」を使ってください。別の鍵になり、つながりません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have already started on another device, don't tap this. Use “Scan QR code” instead. Otherwise this device gets a different key and can't connect."
          }
        }
      }
    },
    "ほかの端末とは、同じ QR コードで設定し直すまでつながらなくなります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device can't connect to your other devices until you set it up again with the same QR code."
          }
        }
      }
    },
    "ほかの端末をつなぐときは、下の「端末を追加」から QR コードを表示します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect another device, show the QR code from “Add a device” below."
          }
        }
      }
    },
    "もう 1 台の iPhone / iPad をつなぐときは、この端末に QR コードを表示して、追加する端末で読み取ります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect another iPhone or iPad, show a QR code on this device and scan it with the one you are adding."
          }
        }
      }
    },
    "もう一度試す" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try Again"
          }
        }
      }
    },
    "やめる" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "カメラ" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera"
          }
        }
      }
    },
    "カメラにする iPhone でアプリを開き、「カメラを始める」を押してください。同じ Wi-Fi にいるか、近くにあれば見つかります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the app on the iPhone you want to use as a camera and tap “Start camera”. It will show up here if it's on the same Wi-Fi or nearby."
          }
        }
      }
    },
    "カメラにする端末と、映像を見る端末で、同じ鍵を持ちます。鍵が同じ端末どうしだけがつながり、通信は暗号化されます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera and the devices you watch from share one key. Only devices with the same key can connect, and everything they send is encrypted."
          }
        }
      }
    },
    "カメラにつないでいます…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecting to the camera…"
          }
        }
