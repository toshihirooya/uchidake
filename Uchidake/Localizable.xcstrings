    },
    "待ち受けを開始できません: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't accept viewers: %@"
          }
        }
      }
    },
    "戻る" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        }
      }
    },
    "押しているあいだ話しかける" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold to talk"
          }
        }
      }
    },
    "押して話す" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
